{
  "name": "tint-and-tell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fixtures:check": "pnpm --filter @tint/protocol fixtures:check",
    "palette": "pnpm --filter @tint/game-core palette",
    "playtest": "pnpm --filter @tint/playtester --silent playtest",
    "test:e2e": "e2e run tests/socket.e2e.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@e2e-dev/web": "^0.15.4",
    "e2e": "^0.22.0",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
