    "app.name" : {
      "comment" : "App name and the lockup accessibility label. Keep the brand in Latin script.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tint & Tell"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tint & Tell"
          }
        }
      }
    },
    "app.pitch" : {
      "comment" : "Opening sentence on the design cover.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People and Grok try to land on the same shade with nothing but a word."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ludzie i Grok próbują trafić ten sam odcień samym językiem skojarzeń."
          }
        }
      }
    },
    "app.tagline" : {
      "comment" : "Home line under the lockup. Design cover and the first screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folded, the phone keeps the secret. Unfolded, it becomes the table."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Złożony telefon trzyma sekret, rozłożony staje się stołem."
          }
        }
      }
    },
    "grok.knows" : {
      "comment" : "Title on the face-down Grok card.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok knows the shade"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok zna odcień"
          }
        }
      }
    },
    "grok.noOneLooks" : {
      "comment" : "Caption under the Grok card. PDF page 3.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody has to look. Unfold the phone and Grok will put the clue on the table."
