        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikt nie musi patrzeć. Rozłóż telefon, Grok poda podpowiedź na stole."
          }
        }
      }
    },
    "handoff.iAm" : {
