{
  "name": "@tint/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tint/game-core": "workspace:*",
    "@tint/protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime=false --strict-vars=false && biome format --write worker-configuration.d.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "xai:probe": "node scripts/xai-probe.mjs",
    "e2e:grok": "node scripts/e2e-grok.mjs"
  }
}
